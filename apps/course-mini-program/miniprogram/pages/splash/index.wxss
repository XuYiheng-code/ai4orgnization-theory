.splash-page {
  position: fixed;
  top: 0; right: 0; bottom: 0; left: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  z-index: 9999;
  overflow: hidden;
}

.splash-page::before {
  content: "";
  position: absolute;
  top: -20%; right: -30%;
  width: 80%; height: 80%;
  background: radial-gradient(circle, rgba(255, 159, 67, .25), transparent 60%);
  filter: blur(40rpx);
  animation: orbFloat 7s ease-in-out infinite alternate;
  z-index: 0;
}
.splash-page::after {
  content: "";
  position: absolute;
  bottom: -20%; left: -30%;
  width: 80%; height: 80%;
  background: radial-gradient(circle, rgba(10, 64, 122, .18), transparent 60%);
  filter: blur(40rpx);
  animation: orbFloat 9s ease-in-out infinite alternate-reverse;
  z-index: 0;
}

.splash-stage {
  position: relative;
  z-index: 1;
  width: 100vw;
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  animation: stageFade .45s ease both;
}
.splash-video {
  width: 100%;
  height: 100%;
}

.splash-fallback {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  animation: fallbackIn .5s ease both;
}
.splash-fallback-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 28rpx;
  padding: 80rpx 64rpx;
}
.splash-orb {
  width: 200rpx;
  height: 200rpx;
  border-radius: 60rpx;
  background: linear-gradient(135deg, #0a407a 0%, #1664ab 60%, #ff9f43 130%);
  position: relative;
  box-shadow: 0 24rpx 64rpx rgba(10, 64, 122, .35);
  animation: orbScale .9s ease both;
}
.splash-orb::after {
  content: "";
  position: absolute;
  inset: 22rpx;
  border-radius: 40rpx;
  background: radial-gradient(circle at 30% 30%, rgba(255, 255, 255, .55), rgba(255, 255, 255, 0) 60%);
}
.splash-course {
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: var(--ink);
  text-align: center;
  font-family: "Songti SC", "STSong", "SimSun", Georgia, serif;
  animation: textIn .6s ease .15s both;
}
.splash-org {
  font-size: 26rpx;
  color: var(--muted);
  letter-spacing: 6rpx;
  text-align: center;
  animation: textIn .6s ease .3s both;
}

.splash-skip {
  position: fixed;
  right: 36rpx;
  bottom: calc(56rpx + env(safe-area-inset-bottom));
  font-size: 22rpx;
  color: rgba(10, 64, 122, .55);
  letter-spacing: 1rpx;
  z-index: 2;
}

@keyframes orbFloat {
  0% { transform: translate(0, 0); }
  100% { transform: translate(40rpx, -30rpx); }
}
@keyframes stageFade {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes fallbackIn {
  from { opacity: 0; transform: scale(.98); }
  to { opacity: 1; transform: scale(1); }
}
@keyframes orbScale {
  0% { transform: scale(.6); opacity: 0; }
  60% { transform: scale(1.05); opacity: 1; }
  100% { transform: scale(1); opacity: 1; }
}
@keyframes textIn {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}
