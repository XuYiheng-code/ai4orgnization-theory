<view class="login-page">
  <!-- 顶部品牌区（深蓝） -->
  <view class="login-art">
    <view class="brand-row">
      <view class="brand-mark"><image class="brand-logo" src="../../assets/course-logo.png" mode="aspectFit"></image></view>
      <view class="brand-text">
        <view class="brand-eyebrow">AI & ORGANIZATION</view>
        <view class="brand-title">学习平台登录</view>
      </view>
    </view>
    <view class="brand-lead">注册后即可登录教学平台并生成课程。<text class="brand-strong">官网与小程序共享同一份账户与数据</text>。</view>
  </view>

  <!-- 主体卡片 -->
  <view class="login-card">
    <!-- Tab 切换 -->
    <view class="tab-bar" role="tablist">
      <view class="tab {{mode==='login'?'is-active':''}}" data-mode="login" bindtap="switchMode" id="tab-login">登录</view>
      <view class="tab {{mode==='register'?'is-active':''}}" data-mode="register" bindtap="switchMode" id="tab-register">注册</view>
      <view class="tab {{mode==='reset'?'is-active':''}}" data-mode="reset" bindtap="switchMode" id="tab-reset">重置密码</view>
    </view>

    <!-- 登录 -->
    <view class="form-pane" wx:if="{{mode==='login'}}">
      <view class="form-title">登录你的账户</view>
      <view class="form-hint">使用注册时的邮箱或手机号 + 密码。</view>
      <view class="field">
        <text class="field-label">邮箱 / 手机号</text>
        <input class="field-input" placeholder-class="field-ph" type="text" name="account" value="{{form.login.account}}" placeholder="you@example.com 或 13800000000" bindinput="onInput" data-form="login" data-name="account" />
      </view>
      <view class="field">
        <text class="field-label">密码</text>
        <input class="field-input" placeholder-class="field-ph" password name="password" value="{{form.login.password}}" placeholder="至少 8 位" bindinput="onInput" data-form="login" data-name="password" />
      </view>
      <view class="form-actions">
        <button class="btn-primary" bindtap="submit" data-form="login" loading="{{loading.login}}">登录</button>
      </view>
      <view class="form-foot">
        <text>没有账号？</text>
        <text class="link" bindtap="switchMode" data-mode="register">立即注册</text>
        <text class="dot">·</text>
        <text class="link" bindtap="switchMode" data-mode="reset">忘记密码</text>
      </view>
    </view>

    <!-- 注册 -->
    <view class="form-pane" wx:if="{{mode==='register'}}">
      <view class="form-title">创建新账户</view>
      <view class="form-hint">先选择身份，课程学生需填学号。</view>

      <view class="role-toggle">
        <view class="role-option {{form.register.accountType==='student'?'is-active':''}}" data-role="student" bindtap="pickRole">
          <view class="role-dot"></view>
          <view class="role-body">
            <view class="role-name">课程学生</view>
            <view class="role-desc">需填学号，便于教师审核</view>
          </view>
        </view>
        <view class="role-option {{form.register.accountType==='guest'?'is-active':''}}" data-role="guest" bindtap="pickRole">
          <view class="role-dot"></view>
          <view class="role-body">
            <view class="role-name">游客</view>
            <view class="role-desc">公开浏览，不参与课程数据</view>
          </view>
        </view>
      </view>

      <view class="field" wx:if="{{form.register.accountType==='student'}}">
        <text class="field-label">学号</text>
        <input class="field-input" placeholder-class="field-ph" type="text" name="studentId" value="{{form.register.studentId}}" placeholder="例如 MF20260001" bindinput="onInput" data-form="register" data-name="studentId" />
      </view>
      <view class="field">
        <text class="field-label">姓名 / 昵称</text>
        <input class="field-input" placeholder-class="field-ph" type="text" name="name" value="{{form.register.name}}" placeholder="将在课程作品上显示" maxlength="30" bindinput="onInput" data-form="register" data-name="name" />
      </view>
      <view class="field">
        <text class="field-label">邮箱</text>
        <input class="field-input" placeholder-class="field-ph" type="text" name="email" value="{{form.register.email}}" placeholder="you@example.com" bindinput="onInput" data-form="register" data-name="email" />
      </view>
      <view class="field">
        <text class="field-label">手机号 <text class="muted">（邮箱或手机号至少填一个）</text></text>
        <input class="field-input" placeholder-class="field-ph" type="number" name="phone" value="{{form.register.phone}}" placeholder="13800000000" bindinput="onInput" data-form="register" data-name="phone" />
      </view>
      <view class="field">
        <text class="field-label">密码</text>
        <input class="field-input" placeholder-class="field-ph" password name="password" value="{{form.register.password}}" placeholder="至少 8 位" bindinput="onInput" data-form="register" data-name="password" />
      </view>

      <view class="form-actions">
        <button class="btn-primary" bindtap="submit" data-form="register" loading="{{loading.register}}">注册并登录</button>
      </view>
      <view class="form-foot">
        <text>已有账号？</text>
        <text class="link" bindtap="switchMode" data-mode="login">返回登录</text>
      </view>
    </view>

    <!-- 重置 -->
    <view class="form-pane" wx:if="{{mode==='reset'}}">
      <view class="form-title">重置密码</view>
      <view class="form-hint">凭原密码重置新密码。成功后该账号的所有设备会重新登录。</view>
      <view class="field">
        <text class="field-label">邮箱 / 手机号</text>
        <input class="field-input" placeholder-class="field-ph" type="text" name="account" value="{{form.reset.account}}" placeholder="你注册时使用的账号" bindinput="onInput" data-form="reset" data-name="account" />
      </view>
      <view class="field">
        <text class="field-label">原密码</text>
        <input class="field-input" placeholder-class="field-ph" password name="oldPassword" value="{{form.reset.oldPassword}}" placeholder="至少 8 位" bindinput="onInput" data-form="reset" data-name="oldPassword" />
      </view>
      <view class="field">
        <text class="field-label">新密码</text>
        <input class="field-input" placeholder-class="field-ph" password name="newPassword" value="{{form.reset.newPassword}}" placeholder="至少 8 位" bindinput="onInput" data-form="reset" data-name="newPassword" />
      </view>
      <view class="form-actions">
        <button class="btn-primary" bindtap="submit" data-form="reset" loading="{{loading.reset}}">重置密码</button>
      </view>
      <view class="form-foot">
        <text class="link" bindtap="switchMode" data-mode="login">返回登录</text>
      </view>
    </view>

    <!-- 错误提示 -->
    <view class="feedback {{feedback.kind}}" wx:if="{{feedback.text}}">{{feedback.text}}</view>

    <view class="privacy-note" bindtap="openPrivacy">登录即表示你已阅读并同意《隐私保护指引》。点击查看完整文本。</view>
  </view>

  <privacy-modal visible="{{showPrivacy}}" bind:agree="onPrivacyAgreed" bind:cancel="onPrivacyCancel" />
</view>
