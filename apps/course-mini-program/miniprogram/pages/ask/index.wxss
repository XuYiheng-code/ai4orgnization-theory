.ask-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--paper);
}

/* 自定义导航 */
.ask-nav {
  flex-shrink: 0;
  padding: 0 24rpx 18rpx;
  background: var(--navy);
  color: #fff;
}
.nav-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.nav-side {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 16rpx 6rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.08);
  flex-shrink: 0;
}
.nav-side--right { background: rgba(255, 159, 67, 0.18); }
.nav-side:active { background: rgba(255, 255, 255, 0.18); }
.nav-side-label { font-size: 20rpx; letter-spacing: 1rpx; }
.nav-icon { width: 30rpx; height: 30rpx; position: relative; }
.nav-icon--list::before {
  content: ""; position: absolute; left: 0; right: 0; top: 4rpx; height: 4rpx;
  border-radius: 4rpx; background: #fff;
  box-shadow: 0 8rpx 0 #fff, 0 16rpx 0 #fff;
}
.nav-icon--plus::before, .nav-icon--plus::after {
  content: ""; position: absolute; left: 50%; top: 50%; background: #fff;
}
.nav-icon--plus::before { width: 22rpx; height: 4rpx; transform: translate(-50%, -50%); border-radius: 4rpx; }
.nav-icon--plus::after  { width: 4rpx; height: 22rpx; transform: translate(-50%, -50%); border-radius: 4rpx; }

.nav-title-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.nav-title {
  margin-top: 4rpx;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  white-space: nowrap;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
}
.nav-sub {
  margin-top: 4rpx;
  color: #c9d6e6;
  font-size: 20rpx;
  max-width: 100%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 欢迎页：只放引导文案，居中且与底部输入条有足够间距 */
.ask-welcome {
  flex: 1 1 auto;
  min-height: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx 56rpx 220rpx;
  text-align: center;
  overflow: hidden;
  position: relative;
}
.welcome-mark {
  width: 120rpx;
  height: 120rpx;
  border-radius: 36rpx;
  margin-bottom: 36rpx;
  background: linear-gradient(135deg, #0a407a 0%, #1664ab 60%, #ff9f43 130%);
  position: relative;
  box-shadow: 0 12rpx 40rpx rgba(10, 64, 122, .25);
  animation: floatY 3.6s ease-in-out infinite;
}
.welcome-mark::after {
  content: "";
  position: absolute;
  left: 22rpx; top: 22rpx;
  width: 76rpx; height: 76rpx;
  border-radius: 22rpx;
  background: radial-gradient(circle at 30% 30%, rgba(255,255,255,.85), rgba(255,255,255,0) 60%);
}
@keyframes floatY {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8rpx); }
}
.welcome-hint { max-width: 640rpx; }
.welcome-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.5;
}
.welcome-copy {
  margin-top: 18rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--muted);
}

/* 消息列表 */
.message-list {
  flex: 1 1 auto;
  min-height: 0;
  padding: 24rpx 28rpx 0;
}
.message-list-inner { display: flex; flex-direction: column; gap: 24rpx; }
.message { display: flex; }
.message--user { justify-content: flex-end; }
.message--assistant { justify-content: flex-start; }
.message-bubble {
  max-width: 82%;
  padding: 22rpx 26rpx;
  border-radius: 26rpx;
  font-size: 28rpx;
  line-height: 1.7;
  word-break: break-word;
}
.message--user .message-bubble {
  background: var(--navy);
  color: #fff;
  border-bottom-right-radius: 8rpx;
}
.message--assistant .message-bubble {
  background: var(--surface);
  color: var(--ink);
  border: 1rpx solid var(--line);
  border-bottom-left-radius: 8rpx;
}
.message-attachments { margin-bottom: 12rpx; }
.message-attachment {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, .15);
  font-size: 22rpx;
}
.message--assistant .message-attachment { background: #e3e9f2; }
.attachment-icon { font-weight: 600; }
.attachment-name { opacity: .85; }

.bubble-loading {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 24rpx 26rpx;
}
.typing-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--muted);
  animation: typing 1.2s infinite ease-in-out;
}
.typing-dot:nth-child(2) { animation-delay: .2s; }
.typing-dot:nth-child(3) { animation-delay: .4s; }
@keyframes typing {
  0%, 80%, 100% { transform: scale(.6); opacity: .4; }
  40% { transform: scale(1); opacity: 1; }
}
.list-bottom { height: 24rpx; }

/* 输入区：固定在底部，确保始终可见 */
.ask-input-bar {
  flex-shrink: 0;
  padding: 16rpx 24rpx 0;
  background: #fff;
  border-top: 1rpx solid var(--line);
  box-shadow: 0 -6rpx 20rpx rgba(10, 20, 35, .04);
}
.attachment-preview {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 16rpx;
}
.preview-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 14rpx;
  border-radius: 14rpx;
  background: var(--surface);
  font-size: 22rpx;
}
.preview-thumb { width: 48rpx; height: 48rpx; border-radius: 8rpx; }
.preview-file { padding: 6rpx 10rpx; border-radius: 8rpx; background: var(--navy); color: #fff; }
.preview-name { max-width: 220rpx; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.preview-remove { color: var(--danger); font-size: 28rpx; padding: 0 6rpx; }

.input-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 72rpx;
}
.tool-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--surface);
  color: var(--navy);
  font-size: 40rpx;
  font-weight: 300;
  flex-shrink: 0;
}
.ask-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 36rpx;
  background: var(--surface);
  font-size: 28rpx;
  color: var(--ink);
}
.input-placeholder { color: #9aa6b5; }
.voice-btn {
  flex-shrink: 0;
  height: 72rpx;
  padding: 0 28rpx;
  border-radius: 36rpx;
  background: var(--navy);
  color: #fff;
  font-size: 27rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
}
.voice-btn:active { background: #08345f; }
.send-btn {
  flex-shrink: 0;
  height: 72rpx;
  padding: 0 32rpx;
  border-radius: 36rpx;
  background: var(--navy);
  color: #fff;
  font-size: 27rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.send-btn:active { opacity: .9; }

/* 工具面板 */
.tools-panel {
  display: flex;
  gap: 32rpx;
  padding: 24rpx 8rpx 4rpx;
}
.tool-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}
.tool-label-stack { display: flex; flex-direction: column; align-items: center; gap: 2rpx; }
.tool-sub { font-size: 18rpx; color: #9aa6b5; }
.tool-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: var(--surface);
  position: relative;
}
.tool-icon--image::before {
  content: "";
  position: absolute;
  top: 50%;
  left: 50%;
  width: 38rpx;
  height: 30rpx;
  transform: translate(-50%, -50%);
  border: 4rpx solid var(--navy);
  border-radius: 6rpx;
}
.tool-icon--image::after {
  content: "";
  position: absolute;
  top: 46%;
  left: 42%;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--orange);
}
.tool-icon--file::before {
  content: "";
  position: absolute;
  top: 50%;
  left: 50%;
  width: 32rpx;
  height: 40rpx;
  transform: translate(-50%, -50%);
  border: 4rpx solid var(--navy);
  border-radius: 0 10rpx 0 0;
  background: linear-gradient(135deg, transparent 40%, var(--navy) 40%, var(--navy) 55%, transparent 55%);
}
.tool-icon--voice::before {
  content: "";
  position: absolute;
  top: 40%;
  left: 50%;
  width: 22rpx;
  height: 32rpx;
  transform: translate(-50%, -50%);
  border: 4rpx solid var(--navy);
  border-radius: 12rpx;
}
.tool-icon--voice::after {
  content: "";
  position: absolute;
  top: 66%;
  left: 50%;
  width: 24rpx;
  height: 16rpx;
  transform: translate(-50%, -50%);
  border: 4rpx solid var(--navy);
  border-top: 0;
  border-radius: 0 0 16rpx 16rpx;
}
.tool-label { font-size: 22rpx; color: var(--muted); }

/* 语音浮层 */
.voice-overlay {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(10, 20, 35, .55);
  z-index: 2000;
}
.voice-panel {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  padding: 60rpx 70rpx;
  border-radius: 32rpx;
  background: #fff;
}
.voice-wave {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--navy);
  animation: pulse 1.2s infinite;
}
@keyframes pulse {
  0% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.1); opacity: .8; }
  100% { transform: scale(1); opacity: 1; }
}
.voice-tip { font-size: 30rpx; color: var(--ink); }
.voice-time { font-size: 40rpx; font-weight: 700; color: var(--navy); }

/* 历史会话侧栏 */
.drawer-mask {
  position: fixed;
  top: 0; right: 0; bottom: 0; left: 0;
  background: rgba(10, 20, 35, .45);
  z-index: 1500;
  animation: fadeIn .2s ease;
}
.drawer {
  position: fixed;
  top: 0; bottom: 0; left: 0;
  width: 78%;
  max-width: 640rpx;
  background: #f6f8fb;
  z-index: 1600;
  transform: translateX(-100%);
  transition: transform .28s ease;
  display: flex;
  flex-direction: column;
  box-shadow: 6rpx 0 24rpx rgba(0, 0, 0, 0.12);
}
.drawer--open { transform: translateX(0); }
.drawer-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx 32rpx 18rpx;
  background: var(--navy);
  color: #fff;
}
.drawer-title { font-size: 34rpx; font-weight: 700; letter-spacing: 1rpx; }
.drawer-new {
  display: flex; align-items: center; gap: 8rpx;
  padding: 10rpx 22rpx;
  background: rgba(255, 159, 67, .25);
  border-radius: 999rpx;
  font-size: 24rpx;
}
.drawer-new:active { background: rgba(255, 159, 67, .42); }
.drawer-new-icon {
  width: 24rpx; height: 24rpx; position: relative;
}
.drawer-new-icon::before, .drawer-new-icon::after {
  content: ""; position: absolute; left: 50%; top: 50%; background: #fff;
}
.drawer-new-icon::before { width: 18rpx; height: 3rpx; transform: translate(-50%, -50%); border-radius: 3rpx; }
.drawer-new-icon::after  { width: 3rpx; height: 18rpx; transform: translate(-50%, -50%); border-radius: 3rpx; }

.drawer-sub {
  padding: 16rpx 32rpx;
  font-size: 22rpx;
  color: var(--muted);
  background: var(--navy);
  color: #c9d6e6;
  margin-bottom: 12rpx;
}
.drawer-list {
  flex: 1 1 auto;
  padding: 12rpx 24rpx 64rpx;
  box-sizing: border-box;
}
.drawer-empty {
  padding: 80rpx 32rpx;
  text-align: center;
  color: var(--muted);
  font-size: 26rpx;
  line-height: 1.8;
}
.drawer-item {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 14rpx;
  border-radius: 22rpx;
  background: #fff;
  border: 1rpx solid var(--line);
}
.drawer-item--active {
  border-color: var(--orange);
  box-shadow: 0 8rpx 24rpx rgba(255, 159, 67, .14);
}
.drawer-item-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}
.drawer-item-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.drawer-item-preview {
  font-size: 23rpx;
  color: var(--muted);
  line-height: 1.5;
  max-height: 70rpx;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.drawer-item-prefix {
  color: var(--navy);
  font-weight: 600;
  margin-right: 4rpx;
}
.drawer-item-meta {
  font-size: 20rpx;
  color: var(--muted);
  letter-spacing: 1rpx;
}
.drawer-item-delete {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: 14rpx;
  background: #fdebee;
  color: #cc3344;
  font-size: 22rpx;
  align-self: center;
}
.drawer-item-delete:active { background: #f7d6dd; }
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
