.profile-page { padding: 34rpx 32rpx calc(132rpx + env(safe-area-inset-bottom)); }

.profile-guest {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  min-height: calc(100vh - 200rpx);
  padding: 60rpx 40rpx 0;
}
.guest-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  margin-top: 80rpx;
}
.brand-mark {
  width: 140rpx;
  height: 140rpx;
  padding: 18rpx;
  border-radius: 34rpx;
  background: #fff;
  box-shadow: 0 16rpx 44rpx rgba(10, 64, 122, .14);
  margin-bottom: 40rpx;
}
.brand-logo { width: 100%; height: 100%; }
.guest-title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: -1rpx;
  line-height: 1.3;
  font-family: "Songti SC", "STSong", Georgia, serif;
}
.guest-tagline {
  margin-top: 22rpx;
  font-size: 27rpx;
  line-height: 1.7;
  color: var(--muted);
  letter-spacing: 0.5rpx;
}
.guest-cta {
  margin-top: auto;
  padding-bottom: 60rpx;
}
.profile-guest .primary-button { width: 100%; }
.guest-note { margin-top: 22rpx; font-size: 22rpx; color: var(--muted); text-align: center; line-height: 1.6; }

/* 已登录身份卡 */
.profile-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 50rpx 0 30rpx;
}
.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #0a407a, #134d92);
  color: #fff;
  font-size: 52rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 30rpx rgba(10, 64, 122, .18);
}
.avatar-img { border: 1rpx solid var(--line); }
.profile-name { margin-top: 24rpx; font-size: 36rpx; font-weight: 700; color: var(--ink); }
.role-badge {
  margin-top: 12rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  background: #e6eef8;
  color: #0a407a;
}
.role-badge.student { background: #e6eef8; color: #0a407a; }
.role-badge.guest { background: #fff3e6; color: #c25e10; }
.profile-meta { margin-top: 10rpx; font-size: 24rpx; color: var(--muted); }

/* 账号信息卡 */
.section-title { margin: 30rpx 4rpx 14rpx; font-size: 22rpx; color: var(--muted); letter-spacing: 2rpx; font-weight: 600; }
.account-list {
  border: 1rpx solid var(--line);
  border-radius: 22rpx;
  background: #fff;
  overflow: hidden;
}
.account-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 26rpx;
  font-size: 26rpx;
}
.account-row + .account-row { border-top: 1rpx solid var(--line); }
.account-key { color: var(--muted); }
.account-val { color: var(--ink); font-weight: 500; max-width: 60%; word-break: break-all; text-align: right; }

.menu-list {
  border: 1rpx solid var(--line);
  border-radius: 22rpx;
  overflow: hidden;
  background: #fff;
}
.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 26rpx;
}
.menu-item + .menu-item { border-top: 1rpx solid var(--line); }
.menu-main { display: flex; flex-direction: column; gap: 6rpx; }
.menu-title { font-size: 28rpx; font-weight: 600; color: var(--ink); }
.menu-sub { font-size: 22rpx; color: var(--muted); }
.menu-arrow { color: var(--muted); font-size: 34rpx; }
.menu-item--active { background: var(--surface); }

.logout-button {
  width: 100%;
  margin-top: 44rpx;
  min-height: 88rpx;
  border-radius: 22rpx;
  border: 1rpx solid var(--line-strong);
  background: #fff;
  color: var(--danger);
  font-size: 28rpx;
  font-weight: 600;
}
.logout-button::after { border: 0; }

.profile-foot {
  margin-top: 30rpx;
  text-align: center;
  font-size: 21rpx;
  color: var(--muted);
  line-height: 1.6;
}
